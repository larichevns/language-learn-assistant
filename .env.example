# ─── Database (local Docker Postgres via docker-compose.yml) ───
DATABASE_URL="postgresql://lla:lla@localhost:55432/lla?schema=public"

# ─── Auth.js v5 ───
# Generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth (optional for local; credentials login works without it)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI provider: Google Gemini (free tier) ───
GEMINI_API_KEY=""

# ─── Encryption for provider API keys stored in the DB (32-byte hex) ───
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# ─── Internal tokens ───
CRON_SECRET=""
AI_SERVICE_TOKEN=""

# ─── Toggles ───
ENABLE_PROMPT_CACHE="true"
